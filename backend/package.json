{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "A simple CRUD REST API for Persons using AWS Lambda, API Gateway and DynamoDB",
  "scripts": {
    "build": "rm -rf dist && esbuild \"src/handlers/*.ts\" --bundle --platform=node --target=node24 --outdir=dist --entry-names=[name]/index --external:@aws-sdk/*",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
